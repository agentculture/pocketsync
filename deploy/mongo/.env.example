# Copy to deploy/mongo/.env (git-ignored) and set a real password.
# Root user created on first start of an empty data dir; changing these
# later does not alter an existing database.
MONGODB_INITDB_ROOT_USERNAME=pocketsync
MONGODB_INITDB_ROOT_PASSWORD=CHANGE_ME_before_first_start

# Optional: host data root (default ~/.local/share/pocketsync/mongo).
# Note: docker compose does not expand "~" inside .env values; use an
# absolute path here, or leave unset to use the default.
# POCKETSYNC_DATA_DIR=/home/you/.local/share/pocketsync/mongo
