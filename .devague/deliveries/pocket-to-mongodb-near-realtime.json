      "id": "d1",
      "what": "Run t2 after t1 merges (add dependency t2 -> t1) instead of in wave 0",
      "task_ref": "t2",
      "reason": "t2's acceptance criterion 2 maps API responses to model.Recording, which t1 creates; building both in parallel would make t2 invent its own model.py and collide at merge",
      "affects": [
        "t1",
        "t7"
