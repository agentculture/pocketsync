      "origin": "llm",
      "status": "approved",
      "classification": "acceptable",
      "seq": 1
    },
    {
      "id": "d2",
      "what": "Exclude Recording.raw from content_hash (hash the mapped content fields incl. updated_at only)",
      "task_ref": "t1",
      "reason": "t2 stores the full wire response in Recording.raw; any per-request volatile wire field (e.g. signed URLs) would change the hash every poll, making reconcile rewrite every doc and breaking c4/h11 and c40's 0-writes re-run; updated_at stays hashed so real Pocket edits are still detected",
      "affects": [
        "t2",
        "c4",
        "h11",
        "c40"
      ],
      "origin": "llm",
      "status": "approved",
      "classification": "acceptable",
      "seq": 2
    },
    {
      "id": "d3",
      "what": "pocketsync-mongo compose also pins hostname: pocketsync-mongo (beyond t3's criteria)",
      "task_ref": "t3",
      "reason": "atlas-local's single-node replica set records the container hostname in /data/db; without a fixed hostname a re-create comes up RSGhost/ReplicaSetNoPrimary (verified in a throwaway container), which would fail h25/c41",
      "affects": [
        "c30",
        "h25",
        "c41"
      ],
      "origin": "llm",
      "status": "approved",
      "classification": "acceptable",
